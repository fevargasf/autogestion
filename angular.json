{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": "3735869c-4bc1-4274-9ef1-e705c89ee48f"
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "autogestion-frontend-master": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "allowedCommonJsDependencies":["crypto-js"],
            "outputPath": "dist/autogestion-frontend-master",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "aot": true,
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "**/*",
                "input": "node_modules/ngx-extended-pdf-viewer/bleeding-edge",
                "output": "/bleeding-edge/"
              },
              {
                "glob": "**/*.md",
                "input": "src/app/",
                "output": "/assets"
              },
              {
                "glob": "changelog.md",
                "input": "node_modules/ngx-extended-pdf-viewer/",
                "output": "/assets/extended-pdf-viewer/changelog/"
              },
              {
                "glob": "CHANGELOG.md",
                "input": "node_modules/ng2-pdf-viewer/",
                "output": "/assets/ng2-pdf-viewer/changelog/"
              }

            ],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.scss","node_modules/intro.js/introjs.css",
              "./node_modules/angular-notifier/styles/core.css"
            ],
            "scripts": [
              
              "node_modules/intro.js/intro.js"]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "975.46kb",
                  "maximumError": "1.02mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "778.24kb",
                  "maximumError": "16kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "autogestion-frontend-master:build",
            //"proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "browserTarget": "autogestion-frontend-master:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "autogestion-frontend-master:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.scss"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "tsconfig.app.json",
              "tsconfig.spec.json",
              "e2e/tsconfig.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "autogestion-frontend-master:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "autogestion-frontend-master:serve:production"
            }
          }
        }
      }
    }
  },
  "defaultProject": "autogestion-frontend-master"
}
